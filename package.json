{
  "name": "@flokani.digital/erecht24-astro",
  "version": "0.1.0",
  "private": true,
  "description": "Astro Rechtstexte für eRecht24: Rechtstexte beim Build abrufen und statisch ausgeben.",
  "author": "Flokani GmbH",
  "type": "module",
  "license": "MIT",
  "engines": { "node": "^22.12.0 || ^24.0.0" },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./LegalText.astro": "./components/LegalText.astro"
  },
  "files": ["dist", "components"],
  "keywords": ["astro-integration", "astro-component", "erecht24", "rechtstexte"],
  "repository": { "type": "git", "url": "git+https://github.com/Flokani-Digital/erecht24-astro.git" },
  "homepage": "https://github.com/Flokani-Digital/erecht24-astro#readme",
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:integration": "npm run build && node --test test/integration/*.test.mjs",
    "test:live": "npm run build && node --test test/live/*.test.mjs",
    "dev": "npm run build && node scripts/demo.mjs",
    "prepack": "npm run build"
  },
  "peerDependencies": { "astro": "^7.0.0", "vite": "^8.0.13" },
  "dependencies": { "parse5": "^8.0.1" },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/cloudflare": "14.3.4",
    "@astrojs/node": "11.1.6",
    "@types/node": "^24.0.0",
    "astro": "7.3.5",
    "typescript": "^6.0.0",
    "vite": "^8.0.13",
    "wrangler": "4.125.0"
  }
}
