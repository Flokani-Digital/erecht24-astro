---
import SEO from '../components/SEO.astro';
interface Props { title: string; description: string; lang?: 'de' | 'en' }
const { title, description, lang = 'de' } = Astro.props;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <SEO title={title} description={description} />
  </head>
  <body>
    <header>
      <a href="/">Astro Rechtstexte für eRecht24</a>
      <p>Entwicklungsbeispiel · Keine gültigen Rechtstexte</p>
      <nav aria-label="Beispielseiten">
        <a href="/impressum/">Impressum</a>
        <a href="/datenschutz/">Datenschutz</a>
        <a href="/datenschutz-social-media/">Social Media</a>
        <a href="/en/privacy-policy/" lang="en">Privacy policy</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer>Die Demo verwendet ausschließlich künstliche Beispieldaten.</footer>
  </body>
</html>
<style is:global>
  :root { font-family: system-ui, sans-serif; color: #1d2936; background: #f5f6f8; }
  body { max-width: 56rem; margin: auto; padding: 2rem 1.25rem; line-height: 1.6; }
  header { padding-bottom: 1.5rem; border-bottom: 1px solid #cdd4dc; }
  header > a { font-size: 1.2rem; font-weight: 700; }
  nav { display: flex; flex-wrap: wrap; gap: .6rem 1.4rem; }
  a { color: #1359a0; text-underline-offset: .2em; }
  a:focus-visible { outline: 3px solid #1359a0; outline-offset: 4px; }
  main { margin: 2rem 0; padding: 1.5rem; background: white; border: 1px solid #dce1e7; border-radius: .5rem; }
  h1 { line-height: 1.2; font-size: clamp(1.6rem, 4vw, 2.2rem); }
  .legal-text h2 { font-size: 1.25rem; margin-top: 1.5rem; }
  footer, header p { color: #536170; font-size: .9rem; }
</style>
