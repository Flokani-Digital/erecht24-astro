---
import Layout from '../layouts/Layout.astro';
export const prerender = true;
---
<Layout title="Paketbeispiel" description="Beispielseiten für Impressum, Datenschutz und Social-Media-Datenschutz mit künstlichen deutschen und englischen Texten.">
  <h1>Rechtstexte im Astro-Projekt</h1>
  <p>Die verlinkten Seiten zeigen die Einbindung der LegalText-Komponente in ein eigenes Layout.</p>
  <p>Alle Texte in dieser Demo sind künstliche Beispieldaten und dürfen nicht als Rechtstexte veröffentlicht werden.</p>
</Layout>
